+def is_bluealsa_active():
+    """BlueALSAサービスが起動中か確認する。"""
+    try:
+        result = subprocess.run(
+            ["systemctl", "is-active", "--quiet", "bluealsa"],
+            check=False,
+            timeout=5,
+        )
+        return result.returncode == 0
+    except (OSError, subprocess.SubprocessError):
+        return False
+
+
+def get_bluealsa_pcm_list():
+    """ALSAが認識しているPCM一覧を返す。"""
+    try:
+        result = subprocess.run(
+            ["aplay", "-L"],
+            capture_output=True,
+            text=True,
+            errors="ignore",
+            timeout=5,
+            check=False,
+        )
+        if result.returncode != 0:
+            return ""
+        return result.stdout or ""
+    except (OSError, subprocess.SubprocessError):
+        return ""
+
+
+def wait_for_bluealsa_pcm(mac, timeout=10.0):
+    """対象Bluetooth機器のBlueALSA PCMが利用可能になるまで待つ。"""
+    deadline = time.monotonic() + timeout
+
+    while time.monotonic() < deadline:
+        if pcm_list_contains_device(get_bluealsa_pcm_list(), mac):
+            return True
+        time.sleep(0.5)
+
+    return False
+
+
+def write_text_atomically(path, content):
+    """設定ファイルを一時ファイル経由で安全に置き換える。"""
+    temp_path = f"{path}.tmp"
+
+    try:
+        with open(temp_path, "w", encoding="utf-8") as file:
+            file.write(content)
+            file.flush()
+            os.fsync(file.fileno())
+
+        os.replace(temp_path, path)
+    except Exception:
+        try:
+            if os.path.exists(temp_path):
+                os.remove(temp_path)
+        except OSError:
+            pass
+        raise
+
